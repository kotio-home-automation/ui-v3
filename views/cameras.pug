include mixins
block content
    div(class='grid sm:grid-cols-2 lg:grid-cols-3 border-1 border-b-0 border-gray-700 mb-2 rounded-t-sm')
        div(class='sm:col-span-2 lg:col-span-3')
            h2(class='text-center text-gray-100 text-xl') Cameras
        each camera in cameras
            - const cameraClassState = camera.privacy_enabled ? 'iconoir-video-camera-off' : 'text-yellow-500 iconoir-video-camera'
            - const cameraClass = `text-6xl ${cameraClassState}`
            +deviceCard(camera.name, cameraClass)
