block content
    div(class='grid lg:grid-cols-3 border-1 border-b-0 border-gray-700 mb-2 rounded-t-sm')
        div(class='lg:col-span-3')
            h2(class='text-center text-gray-100 text-xl') Cameras
        each camera in cameras
            - const cameraClassState = camera.privacy_enabled ? 'iconoir-video-camera-off' : 'text-yellow-500 iconoir-video-camera'
            - const cameraClass = `text-6xl ${cameraClassState}`
            div(class='border-gray-700 gap-4 rounded-sm p-5 pt-1 m-2 bg-gray-800 text-gray-100 text-center')
                h3(class='mb-2 font-bold underline') #{camera.name}
                i(class=cameraClass)
