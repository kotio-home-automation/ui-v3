block content
    div(class='grid lg:grid-cols-3 border-1 border-b-0 border-black mb-2 rounded-t-sm')
        div(class='lg:col-span-3')
            h2(class='text-center text-gray-700 text-xl') Air Quality
        each airQualityItem in airQuality
            div(class='border-black-50 gap-4 rounded-xl p-5 pt-1 m-2 bg-gray-300 text-gray-700 text-center')
                h3(class='mb-2') #{airQualityItem.name}
                div(class='grid grid-cols-2')
                    div(class='col-span-1')
                        p(class='text-xl text-left') #[i(class='text-3xl iconoir-sun-light')] #{airQualityItem.temperature} °C
                        p(class='text-xl text-left mt-1') #[i(class='text-3xl iconoir-smoking')] #[span(class='text-sm') PM 2.5:] #{airQualityItem.pm25}
                    div(class='col-span-1')
                        p(class='text-xl text-left') #[i(class='text-3xl iconoir-droplet')] #{airQualityItem.humidity} %
                        p(class='text-xl text-left mt-1') #[i(class='text-3xl iconoir-bonfire')] #[span(class='text-sm') VOC:] #{airQualityItem.voc}
                p(class='mt-5 text-xs text-left') Last seen: #{airQualityItem.lastSeen}