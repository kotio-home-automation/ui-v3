block content
    div(class='grid lg:grid-cols-3 border-1 border-b-0 border-gray-700 mb-2 rounded-t-sm')
        div(class='lg:col-span-3')
            h2(class='text-center text-gray-100 text-xl') Air Quality
        each airQualityItem in airQuality
            div(class='border-gray-700 gap-4 rounded-xl p-5 pt-1 m-2 bg-gray-800 text-gray-100 text-center')
                h3(class='mb-2 font-bold underline') #{airQualityItem.name}
                div(class='grid grid-cols-2')
                    div(class='col-span-1')
                        p(class='text-xl text-left') #[i(class='text-3xl iconoir-sun-light pr-2')]
                            span(class='align-top') #{airQualityItem.temperature} °C
                        p(class='text-xl text-left mt-1') #[i(class='text-3xl iconoir-smoking pr-2')]
                            span(class='align-top') #{airQualityItem.pm25}
                                span(class='text-sm') &nbsp;(PM 2.5)
                    div(class='col-span-1')
                        p(class='text-xl text-left') #[i(class='text-3xl iconoir-droplet pr-1')]
                            span(class='align-top') #{airQualityItem.humidity} %
                        p(class='text-xl text-left mt-1') #[i(class='text-3xl iconoir-bonfire pr-1')]
                            span(class='align-top') #{airQualityItem.voc}
                                span(class='text-sm') &nbsp;(VOC)
                p(class='mt-5 text-xs text-left text-gray-400') Last seen: #{airQualityItem.lastSeen}
