include mixins
block content
    div(class='grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 border-1 border-b-0 border-gray-700 mb-2 rounded-t-sm')
        div(class='col-span-2 sm:col-span-2 lg:col-span-4')
            h2(class='text-center text-gray-100 text-xl') Lights
        each light in lights
            - const lightClassBase = 'text-6xl'
            - const lightClassOn = 'text-yellow-500 iconoir-light-bulb-on ' + lightClassBase
            - const lightClassOff = 'iconoir-light-bulb-off ' + lightClassBase
            - const lightClass = light.isOn ? lightClassOn : lightClassOff
            - const lightTargetState = light.isOn ? 'off' : 'on'
            - const lightUrl = '/lights/' + light.id + '/' + lightTargetState
            +deviceCard(light.name, lightClass, light.lastSeen, null, true, lightUrl, '#lights-container')
