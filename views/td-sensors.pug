block content
    div(class='grid sm:grid-cols-2 lg:grid-cols-3 border-1 border-b-0 border-gray-700 mb-2 rounded-t-sm')
        div(class='sm:col-span-2 lg:col-span-3')
            h2(class='text-center text-gray-100 text-xl') Tellstick sensors
        each sensor in sensors
            div(class='border-gray-700 gap-4 rounded-sm p-5 pt-1 m-2 bg-gray-800 text-gray-100 text-center')
                h3(class='mb-2 font-bold underline') #{sensor.name}
                div(class='grid grid-cols-2')
                    div(class='col-span-1')
                        p(class='text-xl text-left') #[i(class='text-3xl iconoir-sun-light pr-1')]
                            span(class='align-top') #{sensor.temperature} °C
                    div(class='col-span-1')
                        if sensor.humidity
                            p(class='text-xl text-left') #[i(class='text-3xl iconoir-droplet pr-1')]
                                span(class='align-top') #{sensor.humidity} h%
                        else
                            p(class='text-xl text-left text-gray-400') #[i(class='text-3xl iconoir-droplet pr-1')]
                                span(class='align-top') No data
