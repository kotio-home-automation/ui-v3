include mixins
block content
    div(class='grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 border-1 border-b-0 border-gray-700 mb-2 rounded-t-sm')
        div(class='col-span-2 sm:col-span-2 lg:col-span-4')
            h2(class='text-center text-gray-100 text-xl') Power outlets
        each device in devices
            - const devicesClassBase = 'text-6xl'
            - const devicesClassOn = 'text-yellow-500 iconoir-flash ' + devicesClassBase
            - const devicesClassOff = 'iconoir-flash-off ' + devicesClassBase
            - const devicesClass = device.switchedOn ? devicesClassOn : devicesClassOff
            - const devicesUrl = device.switchedOn ? '/devices/' + device.id + '/off' : '/devices/' + device.id + '/on'
            +deviceCard(device.name, devicesClass, null, null, true, devicesUrl, '#devices-container')
