include mixins
block content
    div(class='grid sm:grid-cols-2 lg:grid-cols-3 border-1 border-b-0 border-gray-700 mb-2 rounded-t-sm')
        div(class='sm:col-span-2 lg:col-span-3')
            h2(class='text-center text-gray-100 text-xl') Water sensors
        each ws in waterSensors
            - const waterClassState = ws.hasLeak ? 'text-red-500 iconoir-watering-soil' : 'iconoir-droplet-check'
            +deviceCard(ws.name, waterClassState, ws.lastSeen, ws.battery)
