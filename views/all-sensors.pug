block content
    div(class='grid sm:grid-cols-2 lg:grid-cols-3 border-1 border-b-0 border-gray-700 mb-2 rounded-t-sm')
        div(class='sm:col-span-2 lg:col-span-3')
            h2(class='text-center text-gray-100 text-xl') Outdoor sensors
        each sensor in sensors.outdoorSensors
            div(class='border-gray-700 gap-4 rounded-sm p-5 pt-1 m-2 bg-gray-800 text-gray-100 text-center')
                h3(class='mb-2 font-bold underline') #{sensor.name}
                div(class='grid grid-cols-2')
                    div(class='col-span-1')
                        p(class='text-xl text-left') #[i(class='text-3xl iconoir-sun-light pr-1')]
                            span(class='align-top') #{sensor.temperature} °C
                        if sensor.pressure
                            p(class='text-xl text-left mt-1') #[i(class='text-3xl iconoir-wind pr-1')]
                                span(class='align-top') #{sensor.pressure} hPa
                    div(class='col-span-1')
                        if sensor.humidity
                            p(class='text-xl text-left') #[i(class='text-3xl iconoir-droplet pr-1')]
                                span(class='align-top') #{sensor.humidity} %
                if sensor.lastSeen
                    p(class='mt-5 text-xs text-left text-gray-400') Last seen: #{sensor.lastSeen}

        div(class='sm:col-span-2 lg:col-span-3')
            h2(class='text-center text-gray-100 text-xl') Indoor sensors
        each sensor in sensors.indoorSensors
            div(class='border-gray-700 gap-4 rounded-sm p-5 pt-1 m-2 bg-gray-800 text-gray-100 text-center')
                h3(class='mb-2 font-bold underline') #{sensor.name}
                div(class='grid grid-cols-2')
                    div(class='col-span-1')
                        p(class='text-xl text-left') #[i(class='text-3xl iconoir-sun-light pr-1')]
                            span(class='align-top') #{sensor.temperature} °C
                        if sensor.pressure
                            p(class='text-xl text-left mt-1') #[i(class='text-3xl iconoir-wind pr-1')]
                                span(class='align-top') #{sensor.pressure} hPa
                        if sensor.pm25 >= 0
                            p(class='text-xl text-left mt-1') #[i(class='text-3xl iconoir-smoking pr-1')]
                                span(class='align-top') #{sensor.pm25}
                                    span(class='text-xs') &nbsp;μg/m³ (PM2.5)
                    div(class='col-span-1')
                        if sensor.humidity
                            p(class='text-xl text-left') #[i(class='text-3xl iconoir-droplet pr-1')]
                                span(class='align-top') #{sensor.humidity} %
                        if sensor.voc
                            p(class='text-xl text-left mt-1') #[i(class='text-3xl iconoir-bonfire pr-1')]
                                span(class='align-top') #{sensor.voc}
                                    span(class='text-xs') &nbsp;ppb (VOC)
                        if sensor.co2
                            p(class='text-xl text-left mt-1') #[i(class='text-3xl iconoir-cloud-sync pr-1')]
                                span(class='align-top') #{sensor.co2}
                                    span(class='text-xs') &nbsp;ppm (CO2)
                if sensor.lastSeen
                    p(class='mt-5 text-xs text-left text-gray-400') Last seen: #{sensor.lastSeen}

